---
const pathname = Astro.url.pathname;
const isActive = (path: string) => {
  if (path === '/') return pathname === '/';
  return pathname.startsWith(path);
};

const navLinks = [
  { href: '/', label: 'Ana Sayfa' },
  { href: '/hakkimda', label: 'Hakkımda' },
  { href: '/ic-hastaliklari', label: 'İç Hastalıkları' },
  { href: '/siyaset', label: 'Siyaset Bilimi' },
  { href: '/saglik-rehberi', label: 'Sağlık Rehberi' },
  { href: '/infografik', label: 'İnfografikler' },
  { href: '/iletisim', label: 'İletişim' },
];
---

<header class="site-header">
  <div class="container-wide site-header__inner">
    <a href="/" class="site-brand-link" aria-label="Ana sayfa">
      <span class="site-brand">Ömür Atakan Ateş</span>
    </a>

    <div class="site-header__actions">
      <a
        href="/arama"
        class={`site-nav__icon ${isActive('/arama') ? 'active' : ''}`}
        aria-label="Ara"
        title="Ara"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="11" cy="11" r="7"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
      </a>
      <button id="theme-toggle" class="site-nav__icon" aria-label="Tema değiştir" title="Açık / koyu mod" type="button">
        <svg class="theme-icon theme-icon--light" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"></path>
        </svg>
        <svg class="theme-icon theme-icon--dark" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
        </svg>
      </button>
      <button
        id="nav-toggle"
        class="site-nav__icon site-nav__hamburger"
        aria-label="Menüyü aç"
        aria-controls="site-nav"
        aria-expanded="false"
        type="button"
      >
        <svg class="hamburger-icon hamburger-icon--open" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <line x1="3" y1="12" x2="21" y2="12"></line>
          <line x1="3" y1="18" x2="21" y2="18"></line>
        </svg>
        <svg class="hamburger-icon hamburger-icon--close" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>

    <nav id="site-nav" class="site-nav" aria-label="Ana menü" data-open="false">
      {navLinks.map((link) => (
        <a href={link.href} class={isActive(link.href) ? 'active' : ''}>{link.label}</a>
      ))}
    </nav>
  </div>
</header>

<script is:inline>
  (function () {
    const stored = localStorage.getItem('theme');
    const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
    const initial = stored ?? (prefersDark ? 'dark' : 'light');
    document.documentElement.dataset.theme = initial;
  })();

  document.addEventListener('DOMContentLoaded', () => {
    const themeBtn = document.getElementById('theme-toggle');
    if (themeBtn) {
      themeBtn.addEventListener('click', () => {
        const current = document.documentElement.dataset.theme ?? 'light';
        const next = current === 'dark' ? 'light' : 'dark';
        document.documentElement.dataset.theme = next;
        localStorage.setItem('theme', next);
      });
    }

    const navToggle = document.getElementById('nav-toggle');
    const nav = document.getElementById('site-nav');
    if (navToggle && nav) {
      const setOpen = (open) => {
        nav.dataset.open = String(open);
        navToggle.setAttribute('aria-expanded', String(open));
        navToggle.setAttribute('aria-label', open ? 'Menüyü kapat' : 'Menüyü aç');
        document.documentElement.dataset.navOpen = String(open);
      };
      navToggle.addEventListener('click', () => {
        setOpen(nav.dataset.open !== 'true');
      });
      // sayfa içi linke tıklanınca menüyü kapat
      nav.querySelectorAll('a').forEach((a) => {
        a.addEventListener('click', () => setOpen(false));
      });
      // ESC ile kapat
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && nav.dataset.open === 'true') setOpen(false);
      });
    }
  });
</script>
