---
export type SectionKey = 'ic-hastaliklari' | 'siyaset' | 'saglik-rehberi';

export const SECTION_LABELS: Record<SectionKey, string> = {
  'ic-hastaliklari': 'İç Hastalıkları',
  siyaset: 'Siyaset Bilimi',
  'saglik-rehberi': 'Sağlık Rehberi',
};

interface Props {
  title: string;
  description: string;
  href: string;
  publishDate: Date;
  category: string;
  section: SectionKey;
  evidenceLevel?: string;
  coverImage?: string;
  coverImageAlt?: string;
}

const {
  title,
  description,
  href,
  publishDate,
  category,
  section,
  evidenceLevel,
  coverImage,
  coverImageAlt,
} = Astro.props;

const dateFmt = new Intl.DateTimeFormat('tr-TR', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
}).format(publishDate);

const evidenceClass = evidenceLevel ? `evidence-${evidenceLevel.replace(' ', '')}` : '';
---

<article class={`post-card ${coverImage ? 'post-card--with-cover' : ''}`}>
  {coverImage && (
    <a href={href} class="post-card__cover" tabindex="-1" aria-hidden="true">
      <img src={coverImage} alt={coverImageAlt ?? ''} loading="lazy" />
    </a>
  )}
  <div class="post-card__body">
    <div class="post-card__meta">
      <span class={`badge badge--${section}`}>{SECTION_LABELS[section]}</span>
      <span class="badge badge--category">{category}</span>
      {evidenceLevel && (
        <span class={`evidence-badge ${evidenceClass}`} title="Kanıt seviyesi">
          Kanıt {evidenceLevel}
        </span>
      )}
      <time datetime={publishDate.toISOString()}>{dateFmt}</time>
    </div>
    <h2 class="post-card__title">
      <a href={href}>{title}</a>
    </h2>
    <p class="post-card__description">{description}</p>
  </div>
</article>
