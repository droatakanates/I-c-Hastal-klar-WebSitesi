---
/**
 * Newsletter abonelik formu (MailerLite).
 *
 * KURULUM (tek seferlik):
 * 1. https://www.mailerlite.com adresine kayıt ol
 *    (ücretsiz tier: 1.000 abone, 12.000 e-posta/ay, RSS-to-email otomasyonu dahil)
 * 2. Sol menüden Forms → Create new form → "Embedded form"
 * 3. Formu adlandır (örn. "Site footer"), Continue → bir Group seç (yoksa oluştur)
 * 4. Form tasarımını atla, "Embed your form" adımına gel
 * 5. "Plain HTML form" sekmesini aç
 * 6. <form action="..."> içindeki URL'i kopyala, aşağıdaki MAILERLITE_ACTION'a yapıştır
 *
 * RSS-TO-EMAIL OTOMASYONU (yeni yazı çıkınca otomatik mail):
 *   Dashboard → Automation → Create new automation → "RSS feed update" tetikleyici
 *   Feed URL: https://omuratakanates.com/rss.xml
 *   Action: Send email (RSS şablonu otomatik gelir, kişiselleştirip Save edin)
 *   Status: Enable → her saatte bir feed'i tarar, yeni yazı varsa abonelere yollar
 *
 * Pasifken (boş action) bu form gösterilmez.
 */

const MAILERLITE_ACTION = ''; // örn. 'https://app.mailerlite.com/webforms/submit/x1y2z3'

interface Props {
  compact?: boolean; // footer içinde küçük versiyon
}
const { compact = false } = Astro.props;

const enabled = MAILERLITE_ACTION !== '';
---

{enabled && (
  <section class={`newsletter ${compact ? 'newsletter--compact' : ''}`}>
    {!compact && (
      <>
        <h2 class="newsletter__title">Yeni yazılardan haberdar olun</h2>
        <p class="newsletter__lead">
          Ayda 1-2 e-posta, en yeni tıp ve siyaset yazılarının özetleri.
          İstediğiniz zaman tek tıkla ayrılabilirsiniz.
        </p>
      </>
    )}
    {compact && <p class="newsletter__compact-title">📬 Newsletter</p>}
    <form
      action={MAILERLITE_ACTION}
      method="post"
      target="popupwindow"
      onsubmit="window.open(this.action, 'popupwindow', 'width=540,height=640')"
      class="newsletter__form"
    >
      <input type="hidden" name="ml-submit" value="1" />
      <input
        type="email"
        name="fields[email]"
        placeholder="e-posta adresiniz"
        aria-label="E-posta"
        required
        class="newsletter__input"
      />
      <button type="submit" class="newsletter__submit">Abone ol</button>
    </form>
    <p class="newsletter__note">Spam yok. Reklam yok. Üçüncü taraf paylaşımı yok.</p>
  </section>
)}
