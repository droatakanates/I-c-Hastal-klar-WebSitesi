---
import { LOCALES, LOCALE_META, DEFAULT_LOCALE } from '../utils/i18n';
---

<div class="lang-switcher" data-default-locale={DEFAULT_LOCALE}>
  <button
    type="button"
    id="lang-switcher-trigger"
    class="site-nav__icon lang-switcher__trigger"
    aria-haspopup="listbox"
    aria-expanded="false"
    aria-controls="lang-switcher-menu"
    aria-label="Dil seç"
    title="Dil seç"
  >
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <circle cx="12" cy="12" r="10"></circle>
      <line x1="2" y1="12" x2="22" y2="12"></line>
      <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
    </svg>
    <span class="lang-switcher__current-flag" aria-hidden="true">🇹🇷</span>
  </button>
  <ul
    id="lang-switcher-menu"
    class="lang-switcher__menu"
    role="listbox"
    aria-label="Dil seçenekleri"
    hidden
  >
    {LOCALES.map((code) => (
      <li role="option" data-lang={code}>
        <button type="button" class="lang-switcher__option">
          <span class="lang-switcher__flag" aria-hidden="true">{LOCALE_META[code].flag}</span>
          <span class="lang-switcher__name">{LOCALE_META[code].name}</span>
        </button>
      </li>
    ))}
  </ul>
</div>
