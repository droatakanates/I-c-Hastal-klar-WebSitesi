---
import { LOCALES, LOCALE_META, DEFAULT_LOCALE } from '../utils/i18n';
const defaultMeta = LOCALE_META[DEFAULT_LOCALE];
---

<div class="lang-switcher" data-default-locale={DEFAULT_LOCALE}>
  <button
    type="button"
    id="lang-switcher-trigger"
    class="site-nav__icon lang-switcher__trigger"
    aria-haspopup="listbox"
    aria-expanded="false"
    aria-controls="lang-switcher-menu"
    aria-label="Dil seç"
    title="Dil seç"
    data-i18n-aria="nav.languageToggle"
    data-i18n-title="nav.languageToggle"
  >
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <circle cx="12" cy="12" r="10"></circle>
      <line x1="2" y1="12" x2="22" y2="12"></line>
      <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
    </svg>
    <span class="lang-switcher__current-flag" aria-hidden="true" set:html={defaultMeta.flagSvg ?? defaultMeta.flag}></span>
  </button>
  <ul
    id="lang-switcher-menu"
    class="lang-switcher__menu"
    role="listbox"
    aria-label="Dil seçenekleri"
    hidden
  >
    {LOCALES.map((code) => {
      const meta = LOCALE_META[code];
      return (
        <li role="option" data-lang={code}>
          <button type="button" class="lang-switcher__option">
            <span class="lang-switcher__flag" aria-hidden="true" set:html={meta.flagSvg ?? meta.flag}></span>
            <span class="lang-switcher__name">{meta.name}</span>
          </button>
        </li>
      );
    })}
  </ul>
</div>
