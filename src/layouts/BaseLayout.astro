---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  ogType?: 'website' | 'article';
  publishedTime?: Date;
  ogImage?: string;
}

const {
  title,
  description = 'Kanıta dayalı iç hastalıkları içeriği ve siyaset bilimi yazıları.',
  ogType = 'website',
  publishedTime,
  ogImage,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).toString();
const fullTitle =
  title === 'Ana Sayfa' ? 'Ömür Atakan Ateş' : `${title} · Ömür Atakan Ateş`;
const ogImageUrl = ogImage
  ? new URL(ogImage, Astro.site).toString()
  : undefined;
---

<!doctype html>
<html lang="tr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <!-- Open Graph -->
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="omuratakanates.com" />
    <meta property="og:locale" content="tr_TR" />
    {ogImageUrl && <meta property="og:image" content={ogImageUrl} />}
    {publishedTime && (
      <meta property="article:published_time" content={publishedTime.toISOString()} />
    )}

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    {ogImageUrl && <meta name="twitter:image" content={ogImageUrl} />}

    <!-- Font (Geist + Inter fallback + Source Serif başlıklar için) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700&family=Geist+Mono:wght@400;500&family=Inter:wght@400;500;600&family=Source+Serif+4:opsz,wght@8..60,400;8..60,600;8..60,700&display=swap"
      rel="stylesheet"
    />

    <!-- RSS -->
    <link rel="alternate" type="application/rss+xml" title="omuratakanates.com" href="/rss.xml" />
    <link rel="alternate" type="application/rss+xml" title="İç Hastalıkları yazıları" href="/ic-hastaliklari/rss.xml" />
    <link rel="alternate" type="application/rss+xml" title="Sağlık Rehberi yazıları" href="/saglik-rehberi/rss.xml" />
    <link rel="alternate" type="application/rss+xml" title="Siyaset yazıları" href="/siyaset/rss.xml" />
  </head>
  <body>
    <Header />
    <main id="content">
      <slot />
    </main>
    <Footer />

    <!-- Chart.js: sadece sayfada canvas.chart varsa yüklenir (lazy) -->
    <script is:inline>
      (async () => {
        const canvases = document.querySelectorAll('canvas.chart[data-chart]');
        if (canvases.length === 0) return;
        const { Chart, registerables } = await import(
          'https://cdn.jsdelivr.net/npm/chart.js@4.4.7/+esm'
        );
        Chart.register(...registerables);
        const isDark = document.documentElement.dataset.theme === 'dark';
        Chart.defaults.color = isDark ? '#cbd5e1' : '#4a5060';
        Chart.defaults.borderColor = isDark ? '#334155' : '#e5e7eb';
        Chart.defaults.font.family = 'Geist, Inter, system-ui, sans-serif';
        canvases.forEach((canvas) => {
          try {
            const config = JSON.parse(canvas.dataset.chart ?? '{}');
            new Chart(canvas, config);
          } catch (err) {
            console.error('[chart] hata:', err);
          }
        });
      })();
    </script>

    <!-- Mermaid: sadece sayfada mermaid bloğu varsa yüklenir (lazy) -->
    <script is:inline>
      (async () => {
        const blocks = document.querySelectorAll('pre > code.language-mermaid');
        if (blocks.length === 0) return;
        const { default: mermaid } = await import(
          'https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.esm.min.mjs'
        );
        mermaid.initialize({
          startOnLoad: false,
          theme: 'neutral',
          fontFamily: 'Geist, Inter, system-ui, sans-serif',
        });
        blocks.forEach((block) => {
          const container = document.createElement('div');
          container.className = 'mermaid';
          container.textContent = block.textContent ?? '';
          block.parentElement?.replaceWith(container);
        });
        try {
          await mermaid.run({ querySelector: '.mermaid' });
        } catch (err) {
          console.error('[mermaid] render error', err);
        }
      })();
    </script>
  </body>
</html>
