---
import BaseLayout from './BaseLayout.astro';
import { SECTION_LABELS, type SectionKey } from '../components/PostCard.astro';
import RelatedPosts from '../components/RelatedPosts.astro';
import SharePost from '../components/SharePost.astro';
import Giscus from '../components/Giscus.astro';

interface Props {
  title: string;
  description: string;
  publishDate: Date;
  updatedDate?: Date;
  category: string;
  tags: string[];
  section: SectionKey;
  slug: string;
  evidenceLevel?: string;
  icerikTipi?: string;
  okumaSuresi?: string;
  coverImage?: string;
  coverImageAlt?: string;
  references: string[];
}

const {
  title,
  description,
  publishDate,
  updatedDate,
  category,
  tags,
  section,
  slug,
  evidenceLevel,
  icerikTipi,
  okumaSuresi,
  coverImage,
  coverImageAlt,
  references,
} = Astro.props;

const dateFmt = new Intl.DateTimeFormat('tr-TR', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const sectionBase = `/${section}`;
const evidenceClass = evidenceLevel ? `evidence-${evidenceLevel.replace(' ', '')}` : '';

const isMedical = section === 'ic-hastaliklari' || section === 'saglik-rehberi';
const disclaimerColor =
  section === 'ic-hastaliklari'
    ? 'var(--color-ic-hastaliklari)'
    : 'var(--color-saglik-rehberi)';

const fullUrl = new URL(Astro.url.pathname, Astro.site).toString();
---

<BaseLayout
  title={title}
  description={description}
  ogType="article"
  publishedTime={publishDate}
  ogImage={coverImage}
>
  <!-- Okuma ilerleme çubuğu -->
  <div class="reading-progress" aria-hidden="true">
    <div class="reading-progress__bar" id="reading-progress-bar"></div>
  </div>

  {coverImage && (
    <div class="post-cover">
      <img src={coverImage} alt={coverImageAlt ?? ''} />
    </div>
  )}

  <article class="container prose">
    <header class="post-header">
      <div class="post-header__meta">
        <a href={sectionBase} class={`badge badge--${section}`}>{SECTION_LABELS[section]}</a>
        <a href={`${sectionBase}/kategori/${encodeURIComponent(category)}`} class="badge badge--category">
          {category}
        </a>
        {icerikTipi && <span class="badge badge--category">{icerikTipi}</span>}
        {evidenceLevel && (
          <span class={`evidence-badge ${evidenceClass}`}>
            Kanıt Seviyesi {evidenceLevel}
          </span>
        )}
      </div>
      <h1 class="post-header__title">{title}</h1>
      <p class="post-header__description">{description}</p>
      <div class="post-header__meta" style="margin-top: 1rem;">
        <time datetime={publishDate.toISOString()}>
          Yayın: {dateFmt.format(publishDate)}
        </time>
        {updatedDate && (
          <time datetime={updatedDate.toISOString()}>
            Güncelleme: {dateFmt.format(updatedDate)}
          </time>
        )}
        {okumaSuresi && <span>Okuma: {okumaSuresi}</span>}
      </div>
    </header>

    <div class="post-content" id="post-content">
      <slot />
    </div>

    {references.length > 0 && (
      <section class="references" aria-labelledby="references-heading">
        <h2 id="references-heading">Kaynaklar</h2>
        <ol>
          {references.map((ref) => (
            <li>{ref}</li>
          ))}
        </ol>
      </section>
    )}

    {tags.length > 0 && (
      <div class="category-pills" style="margin-top: 2rem;">
        {tags.map((tag) => (
          <span class="category-pill">#{tag}</span>
        ))}
      </div>
    )}

    <SharePost title={title} url={fullUrl} />

    {isMedical && (
      <div style={`margin-top: 2rem; padding: 1rem; background: var(--color-bg-soft); border-left: 3px solid ${disclaimerColor}; border-radius: var(--radius-sm); font-size: 0.92rem; color: var(--color-text-soft);`}>
        <strong style="color: var(--color-text);">Tıbbi sorumluluk reddi:</strong>
        Bu yazı genel bilgilendirme amaçlıdır ve hekim danışmanlığının yerine geçmez.
        Klinik kararlar için yetkili sağlık profesyoneline başvurunuz.
        <a href="/sorumluluk-reddi">Detaylı bilgi</a>.
      </div>
    )}

    <RelatedPosts section={section} currentSlug={slug} currentCategory={category} />

    <Giscus />
  </article>

  <script is:inline>
    (function () {
      const bar = document.getElementById('reading-progress-bar');
      const content = document.getElementById('post-content');
      if (!bar || !content) return;

      function update() {
        const top = content.offsetTop;
        const height = content.offsetHeight;
        const scrolled = Math.max(0, window.scrollY - top + window.innerHeight * 0.2);
        const visible = Math.min(scrolled, height);
        const pct = Math.max(0, Math.min(100, (visible / height) * 100));
        bar.style.width = pct + '%';
      }

      window.addEventListener('scroll', update, { passive: true });
      window.addEventListener('resize', update);
      update();
    })();
  </script>
</BaseLayout>
