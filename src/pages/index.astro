---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';

const icHastaliklariPosts = (
  await getCollection('ic-hastaliklari', ({ data }) => !data.draft)
)
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf())
  .slice(0, 3);

const siyasetPosts = (await getCollection('siyaset', ({ data }) => !data.draft))
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf())
  .slice(0, 3);

const saglikRehberiPosts = (
  await getCollection('saglik-rehberi', ({ data }) => !data.draft)
)
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf())
  .slice(0, 3);
---

<BaseLayout title="Ana Sayfa">
  <section class="home-hero">
    <div class="container-wide">
      <p class="home-hero__eyebrow">Üç düzlemde içerik</p>
      <h1 class="home-hero__title">
        Tıp, sağlık ve siyaset bilimi üzerine
        <span class="home-hero__title--accent">notlar.</span>
      </h1>
      <p class="home-hero__lead">
        Sağlık profesyonelleri için kanıta dayalı iç hastalıkları içeriği,
        hastalar için anlaşılır sağlık rehberi ve akademik bir merakla yazılmış
        siyaset bilimi yazıları.
      </p>

      <div class="home-hero__cards">
        <a href="/ic-hastaliklari" class="home-hero__card home-hero__card--ic-hastaliklari">
          <span class="home-hero__card-tag">Akademik</span>
          <h2>İç Hastalıkları</h2>
          <p>Kılavuz özetleri, olgu sunumları, literatür taramaları.</p>
          <span class="home-hero__card-cta">Bölüme git →</span>
        </a>
        <a href="/saglik-rehberi" class="home-hero__card home-hero__card--saglik-rehberi">
          <span class="home-hero__card-tag">Hasta dostu</span>
          <h2>Sağlık Rehberi</h2>
          <p>Kronik hastalıklar, ilaç kullanımı, beslenme, tarama testleri.</p>
          <span class="home-hero__card-cta">Bölüme git →</span>
        </a>
        <a href="/siyaset" class="home-hero__card home-hero__card--siyaset">
          <span class="home-hero__card-tag">Analiz</span>
          <h2>Siyaset Bilimi</h2>
          <p>Türk siyaseti, karşılaştırmalı siyaset, uluslararası ilişkiler.</p>
          <span class="home-hero__card-cta">Bölüme git →</span>
        </a>
      </div>
    </div>
  </section>

  <section class="container section-strip" aria-labelledby="ic-hastaliklari-heading">
    <div class="section-strip__header">
      <h2 id="ic-hastaliklari-heading" class="section-strip__title">
        <span class="badge badge--ic-hastaliklari" style="vertical-align: middle; margin-right: 0.5rem;">
          İç Hastalıkları
        </span>
        Son yazılar
      </h2>
      <a href="/ic-hastaliklari" class="section-strip__link">Tüm yazılar →</a>
    </div>
    {icHastaliklariPosts.length === 0 ? (
      <p style="color: var(--color-text-muted); font-style: italic;">
        Henüz iç hastalıkları yazısı eklenmedi.
      </p>
    ) : (
      icHastaliklariPosts.map((post) => (
        <PostCard
          title={post.data.title}
          description={post.data.description}
          href={`/ic-hastaliklari/${post.id}`}
          publishDate={post.data.publishDate}
          category={post.data.category}
          section="ic-hastaliklari"
          evidenceLevel={post.data.evidenceLevel}
          coverImage={post.data.coverImage}
          coverImageAlt={post.data.coverImageAlt}
        />
      ))
    )}
  </section>

  <section class="container section-strip" aria-labelledby="saglik-rehberi-heading">
    <div class="section-strip__header">
      <h2 id="saglik-rehberi-heading" class="section-strip__title">
        <span class="badge badge--saglik-rehberi" style="vertical-align: middle; margin-right: 0.5rem;">
          Sağlık Rehberi
        </span>
        Son yazılar
      </h2>
      <a href="/saglik-rehberi" class="section-strip__link">Tüm yazılar →</a>
    </div>
    {saglikRehberiPosts.length === 0 ? (
      <p style="color: var(--color-text-muted); font-style: italic;">
        Henüz sağlık rehberi yazısı eklenmedi.
      </p>
    ) : (
      saglikRehberiPosts.map((post) => (
        <PostCard
          title={post.data.title}
          description={post.data.description}
          href={`/saglik-rehberi/${post.id}`}
          publishDate={post.data.publishDate}
          category={post.data.category}
          section="saglik-rehberi"
          coverImage={post.data.coverImage}
          coverImageAlt={post.data.coverImageAlt}
        />
      ))
    )}
  </section>

  <section class="container section-strip" aria-labelledby="siyaset-heading">
    <div class="section-strip__header">
      <h2 id="siyaset-heading" class="section-strip__title">
        <span class="badge badge--siyaset" style="vertical-align: middle; margin-right: 0.5rem;">
          Siyaset Bilimi
        </span>
        Son yazılar
      </h2>
      <a href="/siyaset" class="section-strip__link">Tüm yazılar →</a>
    </div>
    {siyasetPosts.length === 0 ? (
      <p style="color: var(--color-text-muted); font-style: italic;">
        Henüz siyaset yazısı eklenmedi.
      </p>
    ) : (
      siyasetPosts.map((post) => (
        <PostCard
          title={post.data.title}
          description={post.data.description}
          href={`/siyaset/${post.id}`}
          publishDate={post.data.publishDate}
          category={post.data.category}
          section="siyaset"
          coverImage={post.data.coverImage}
          coverImageAlt={post.data.coverImageAlt}
        />
      ))
    )}
  </section>
</BaseLayout>
