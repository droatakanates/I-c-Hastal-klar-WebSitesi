---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';

const tipPosts = (await getCollection('tip', ({ data }) => !data.draft))
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf())
  .slice(0, 3);

const siyasetPosts = (await getCollection('siyaset', ({ data }) => !data.draft))
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf())
  .slice(0, 3);
---

<BaseLayout title="Ana Sayfa">
  <section class="container hero">
    <h1 class="hero__title">Ömür Atakan Ateş</h1>
    <p class="hero__lead">
      Kanıta dayalı iç hastalıkları içeriği ve siyaset bilimi üzerine yazılar.
      İki ayrı disiplin, tek bir yazar.
    </p>
  </section>

  <section class="container section-strip" aria-labelledby="tip-heading">
    <div class="section-strip__header">
      <h2 id="tip-heading" class="section-strip__title">
        <span class="badge badge--tip" style="vertical-align: middle; margin-right: 0.5rem;">Tıp</span>
        Son yazılar
      </h2>
      <a href="/tip" class="section-strip__link">Tüm tıp yazıları →</a>
    </div>
    {tipPosts.length === 0 ? (
      <p style="color: var(--color-text-muted); font-style: italic;">Henüz tıp yazısı eklenmedi.</p>
    ) : (
      tipPosts.map((post) => (
        <PostCard
          title={post.data.title}
          description={post.data.description}
          href={`/tip/${post.id}`}
          publishDate={post.data.publishDate}
          category={post.data.category}
          section="tip"
          evidenceLevel={post.data.evidenceLevel}
        />
      ))
    )}
  </section>

  <section class="container section-strip" aria-labelledby="siyaset-heading">
    <div class="section-strip__header">
      <h2 id="siyaset-heading" class="section-strip__title">
        <span class="badge badge--siyaset" style="vertical-align: middle; margin-right: 0.5rem;">Siyaset</span>
        Son yazılar
      </h2>
      <a href="/siyaset" class="section-strip__link">Tüm siyaset yazıları →</a>
    </div>
    {siyasetPosts.length === 0 ? (
      <p style="color: var(--color-text-muted); font-style: italic;">Henüz siyaset yazısı eklenmedi.</p>
    ) : (
      siyasetPosts.map((post) => (
        <PostCard
          title={post.data.title}
          description={post.data.description}
          href={`/siyaset/${post.id}`}
          publishDate={post.data.publishDate}
          category={post.data.category}
          section="siyaset"
        />
      ))
    )}
  </section>
</BaseLayout>
