---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { SAGLIK_REHBERI_KATEGORILERI } from '../../content.config';

const posts = (
  await getCollection('saglik-rehberi', ({ data }) => !data.draft)
).sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());
---

<BaseLayout
  title="Sağlık Rehberi"
  description="Hastalar ve aileleri için anlaşılır dilde sağlık bilgileri — kronik hastalıklar, ilaç kullanımı, beslenme, tarama testleri ve sık sorulan sorular."
>
  <div class="section-banner section-banner--saglik-rehberi">
    <div class="container">
      <span class="badge badge--saglik-rehberi section-banner__eyebrow">Bölüm</span>
      <h1 class="section-banner__title">Sağlık Rehberi</h1>
      <p class="section-banner__lead">
        Hasta ve yakınları için anlaşılır dilde bilgilendirme yazıları. Kronik
        hastalıkları yönetmek, ilaçları doğru kullanmak, sağlıklı bir yaşam
        sürdürmek üzerine pratik bilgiler.
      </p>
    </div>
  </div>

  <section class="container">
    <nav class="category-pills" aria-label="Kategoriler">
      {SAGLIK_REHBERI_KATEGORILERI.map((cat) => (
        <a
          href={`/saglik-rehberi/kategori/${encodeURIComponent(cat)}`}
          class="category-pill"
        >
          {cat}
        </a>
      ))}
    </nav>

    <div style="margin-top: 2rem;">
      {posts.length === 0 ? (
        <p style="color: var(--color-text-muted); font-style: italic; padding: 2rem 0;">
          Bu bölümde henüz yazı yok.
        </p>
      ) : (
        posts.map((post) => (
          <PostCard
            title={post.data.title}
            description={post.data.description}
            href={`/saglik-rehberi/${post.id}`}
            publishDate={post.data.publishDate}
            category={post.data.category}
            section="saglik-rehberi"
            coverImage={post.data.coverImage}
            coverImageAlt={post.data.coverImageAlt}
          />
        ))
      )}
    </div>
  </section>
</BaseLayout>
