---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { INFOGRAFIK_BRANSLARI } from '../../content.config';

const posts = (
  await getCollection('infografik', ({ data }) => !data.draft)
).sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());

const hastalarCount = posts.filter((p) => p.data.category === 'Hastalar İçin').length;
const hekimlerCount = posts.filter((p) => p.data.category === 'Hekimler İçin').length;

// Tüm branşları her zaman göster; boş olanlar soluk gösterilir.
const bransSayilari = INFOGRAFIK_BRANSLARI.map((b) => ({
  ad: b,
  sayi: posts.filter((p) => p.data.brans === b).length,
}));
---

<BaseLayout
  title="İnfografikler"
  description="Görsel ağırlıklı içerikler — hastalar ve hekimler için iki ayrı koleksiyon."
>
  <section class="container">
    <div class="hero" style="text-align: left; padding-bottom: 1rem;">
      <span class="badge badge--infografik">Bölüm</span>
      <h1 class="hero__title" style="font-size: 2.25rem; margin-top: 0.5rem;">
        İnfografikler
      </h1>
      <p class="hero__lead" style="margin: 0;">
        Konuyu tek bakışta özetleyen görsel içerikler. İki ana koleksiyon:
        hasta odaklı, anlaşılır anlatım; hekim odaklı, klinik ve akademik içerik.
      </p>
    </div>

    <div class="audience-cards" role="navigation" aria-label="Hedef kitleye göre infografikler">
      <a href="/infografik/kategori/Hastalar İçin" class="audience-card audience-card--patient">
        <div class="audience-card__icon" aria-hidden="true">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" width="48" height="48">
            <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
          </svg>
        </div>
        <h2 class="audience-card__title">Hastalar İçin</h2>
        <p class="audience-card__desc">
          Hastalık belirtileri, korunma yolları, ilaç kullanımı ve günlük yaşam
          önerileri — anlaşılır dilde, görsellerle anlatılan rehberler.
        </p>
        <span class="audience-card__cta">
          {hastalarCount} infografik →
        </span>
      </a>

      <a href="/infografik/kategori/Hekimler İçin" class="audience-card audience-card--clinician">
        <div class="audience-card__icon" aria-hidden="true">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" width="48" height="48">
            <path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/>
            <path d="M12 5v6M9 8h6"/>
          </svg>
        </div>
        <h2 class="audience-card__title">Hekimler İçin</h2>
        <p class="audience-card__desc">
          Tanı algoritmaları, kılavuz özetleri, doz şemaları ve klinik karar
          destekli akış şemaları — sağlık profesyonelleri için klinik referanslar.
        </p>
        <span class="audience-card__cta">
          {hekimlerCount} infografik →
        </span>
      </a>
    </div>

    <div style="margin-top: 3rem;" aria-labelledby="brans-heading">
      <h2 id="brans-heading" style="font-size: 1.4rem; margin-bottom: 1rem;">Branşa göre</h2>
      <nav class="category-pills" aria-label="Branşlar">
        {bransSayilari.map((b) => (
          <a
            href={`/infografik/brans/${b.ad}`}
            class={`category-pill ${b.sayi === 0 ? 'category-pill--empty' : ''}`}
          >
            {b.ad}
            {b.sayi > 0 && <span class="category-pill__count">{b.sayi}</span>}
          </a>
        ))}
      </nav>
    </div>

    <div style="margin-top: 3rem;">
      <h2 style="font-size: 1.4rem; margin-bottom: 1rem;">Son eklenen infografikler</h2>
      {posts.length === 0 ? (
        <p style="color: var(--color-text-muted); font-style: italic; padding: 1rem 0;">
          Henüz infografik eklenmedi.
        </p>
      ) : (
        posts.slice(0, 6).map((post) => (
          <PostCard
            title={post.data.title}
            description={post.data.description}
            href={`/infografik/${post.id}`}
            publishDate={post.data.publishDate}
            category={post.data.category}
            section="infografik"
          />
        ))
      )}
    </div>
  </section>
</BaseLayout>
