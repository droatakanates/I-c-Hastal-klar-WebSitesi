---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { SIYASET_KATEGORILERI } from '../../content.config';

const posts = (await getCollection('siyaset', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf(),
);
---

<BaseLayout
  title="Siyaset"
  description="Siyaset bilimi yazıları — Türk siyaseti, karşılaştırmalı siyaset, uluslararası ilişkiler ve siyaset teorisi üzerine notlar."
>
  <section class="container">
    <div class="hero" style="text-align: left; padding-bottom: 1rem;">
      <span class="badge badge--siyaset">Bölüm</span>
      <h1 class="hero__title" style="font-size: 2.25rem; margin-top: 0.5rem;">Siyaset</h1>
      <p class="hero__lead" style="margin: 0;">
        Siyaset bilimi alanında analiz, makale incelemesi ve karşılaştırmalı çalışmalar.
      </p>
    </div>

    <nav class="category-pills" aria-label="Kategoriler">
      {SIYASET_KATEGORILERI.map((cat) => (
        <a href={`/siyaset/kategori/${encodeURIComponent(cat)}`} class="category-pill">
          {cat}
        </a>
      ))}
    </nav>

    <div style="margin-top: 2rem;">
      {posts.length === 0 ? (
        <p style="color: var(--color-text-muted); font-style: italic; padding: 2rem 0;">
          Bu bölümde henüz yazı yok.
        </p>
      ) : (
        posts.map((post) => (
          <PostCard
            title={post.data.title}
            description={post.data.description}
            href={`/siyaset/${post.id}`}
            publishDate={post.data.publishDate}
            category={post.data.category}
            section="siyaset"
            coverImage={post.data.coverImage}
            coverImageAlt={post.data.coverImageAlt}
          />
        ))
      )}
    </div>
  </section>
</BaseLayout>
