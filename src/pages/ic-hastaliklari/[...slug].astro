---
import { getCollection, render } from 'astro:content';
import PostLayout from '../../layouts/PostLayout.astro';
import { calculateReadingTime } from '../../utils/reading-time';

export async function getStaticPaths() {
  const posts = await getCollection('ic-hastaliklari', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const okumaSuresi = calculateReadingTime(post.body ?? '');
---

<PostLayout
  title={post.data.title}
  description={post.data.description}
  publishDate={post.data.publishDate}
  updatedDate={post.data.updatedDate}
  category={post.data.category}
  tags={post.data.tags}
  section="ic-hastaliklari"
  slug={post.id}
  evidenceLevel={post.data.evidenceLevel}
  icerikTipi={post.data.icerikTipi}
  okumaSuresi={okumaSuresi}
  coverImage={post.data.coverImage}
  coverImageAlt={post.data.coverImageAlt}
  references={post.data.references}
  headings={headings}
>
  <Content />
</PostLayout>
