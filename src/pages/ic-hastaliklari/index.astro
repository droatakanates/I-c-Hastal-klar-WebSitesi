---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { IC_HASTALIKLARI_KATEGORILERI } from '../../content.config';

const posts = (
  await getCollection('ic-hastaliklari', ({ data }) => !data.draft)
).sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());
---

<BaseLayout
  title="İç Hastalıkları"
  description="Kanıta dayalı iç hastalıkları içeriği — olgu sunumları, kılavuz özetleri, literatür taramaları ve klinik pratik notları."
>
  <section class="container">
    <div class="hero" style="text-align: left; padding-bottom: 1rem;">
      <span class="badge badge--ic-hastaliklari">Bölüm</span>
      <h1 class="hero__title" style="font-size: 2.25rem; margin-top: 0.5rem;">
        İç Hastalıkları
      </h1>
      <p class="hero__lead" style="margin: 0;">
        Akademik içerik: iç hastalıkları ve yan dalları üzerine kanıta dayalı yazılar.
        Kılavuz özetleri, olgu sunumları, literatür taramaları.
      </p>
    </div>

    <nav class="category-pills" aria-label="Kategoriler">
      {IC_HASTALIKLARI_KATEGORILERI.map((cat) => (
        <a
          href={`/ic-hastaliklari/kategori/${encodeURIComponent(cat)}`}
          class="category-pill"
        >
          {cat}
        </a>
      ))}
    </nav>

    <div style="margin-top: 2rem;">
      {posts.length === 0 ? (
        <p style="color: var(--color-text-muted); font-style: italic; padding: 2rem 0;">
          Bu bölümde henüz yazı yok.
        </p>
      ) : (
        posts.map((post) => (
          <PostCard
            title={post.data.title}
            description={post.data.description}
            href={`/ic-hastaliklari/${post.id}`}
            publishDate={post.data.publishDate}
            category={post.data.category}
            section="ic-hastaliklari"
            evidenceLevel={post.data.evidenceLevel}
            coverImage={post.data.coverImage}
            coverImageAlt={post.data.coverImageAlt}
          />
        ))
      )}
    </div>
  </section>
</BaseLayout>
