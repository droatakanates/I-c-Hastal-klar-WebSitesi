---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Sayfa Bulunamadı" description="Aradığınız sayfa bulunamadı.">
  <section class="container" style="padding: 4rem 0; text-align: center;">
    <p style="font-size: 4rem; font-family: var(--font-serif); margin: 0; color: var(--color-text-muted);">
      404
    </p>
    <h1 style="font-size: 2rem; margin: 0.5rem 0 1rem;">Sayfa bulunamadı</h1>
    <p style="color: var(--color-text-soft); max-width: 480px; margin: 0 auto 2rem;">
      Bağlantı eski olabilir veya yazı silinmiş olabilir. Aşağıdaki bölümlerden
      devam edebilirsiniz.
    </p>
    <p style="display: flex; gap: 0.5rem; justify-content: center; flex-wrap: wrap;">
      <a href="/" class="badge badge--category">Ana Sayfa</a>
      <a href="/ic-hastaliklari" class="badge badge--ic-hastaliklari" style="text-decoration: none;">
        İç Hastalıkları
      </a>
      <a href="/saglik-rehberi" class="badge badge--saglik-rehberi" style="text-decoration: none;">
        Sağlık Rehberi
      </a>
      <a href="/siyaset" class="badge badge--siyaset" style="text-decoration: none;">
        Siyaset Bilimi
      </a>
    </p>
  </section>
</BaseLayout>
